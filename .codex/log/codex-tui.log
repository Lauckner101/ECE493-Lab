Validation error\n\n  /papers/drafts:\n    post:\n      summary: Save paper draft\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/PaperDraftRequest'\n      responses:\n        '201':\n          description: Draft saved\n        '400':\n          description: Validation error or empty draft\n\n  /papers/{paperId}/submit:\n    put:\n      summary: Submit an existing draft\n      parameters:\n        - in: path\n          name: paperId\n          required: true\n          schema:\n            type: string\n      requestBody:\n        required: true\n        content:\n          multipart/form-data:\n            schema:\n              $ref: '#/components/schemas/PaperSubmissionRequest'\n      responses:\n        '200':\n          description: Draft submitted\n        '400':\n          description: Validation error\n\n  /papers/{paperId}/referees:\n    post:\n      summary: Assign a referee to a paper\n      parameters:\n        - in: path\n          name: paperId\n          required: true\n          schema:\n            type: string\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/RefereeAssignRequest'\n      responses:\n        '201':\n          description: Referee assigned\n        '400':\n          description: Validation error\n        '409':\n          description: Duplicate or capacity exceeded\n\n  /invitations/{invitationId}/accept:\n    post:\n      summary: Accept review invitation\n      parameters:\n        - in: path\n          name: invitationId\n          required: true\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Invitation accepted\n        '409':\n          description: Workload or capacity exceeded\n\n  /invitations/{invitationId}/reject:\n    post:\n      summary: Reject review invitation\n      parameters:\n        - in: path\n          name: invitationId\n          required: true\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Invitation rejected\n\n  /papers/{paperId}/reviews:\n    post:\n      summary: Submit review\n      parameters:\n        - in: path\n          name: paperId\n          required: true\n          schema:\n            type: string\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/ReviewSubmissionRequest'\n      responses:\n        '201':\n          description: Review submitted\n        '400':\n          description: Validation error\n        '409':\n          description: Duplicate submission\n\n  /papers/{paperId}/decision:\n    post:\n      summary: Submit final decision\n      parameters:\n        - in: path\n          name: paperId\n          required: true\n          schema:\n            type: string\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/DecisionRequest'\n      responses:\n        '201':\n          description: Decision recorded\n        '400':\n          description: Validation error\n        '409':\n          description: Insufficient reviews or duplicate decision\n\n  /schedule/generate:\n    post:\n      summary: Generate conference schedule\n      requestBody:\n        required: false\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/ScheduleGenerateRequest'\n      responses:\n        '200':\n          description: Schedule generated\n        '400':\n          description: Validation error or unsatisfiable constraints\n\n  /schedule/current:\n    get:\n      summary: Get current schedule\n      responses:\n        '200':\n          description: Current schedule\n\n    put:\n      summary: Edit current schedule\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/ScheduleEditRequest'\n      responses:\n        '200':\n          description: Schedule updated\n        '400':\n          description: Validation error or conflicts\n\n  /conference/registration:\n    post:\n      summary: Register for conference\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/RegistrationRequest'\n      responses:\n        '201':\n          description: Registration created\n        '400':\n          description: Validation error\n\n  /conference/registration/{registrationId}/pay:\n    post:\n      summary: Process conference registration payment\n      parameters:\n        - in: path\n          name: registrationId\n          required: true\n          schema:\n            type: string\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/PaymentRequest'\n      responses:\n        '200':\n          description: Payment processed\n        '400':\n          description: Validation error\n        '402':\n          description: Payment declined\n\ncomponents:\n  schemas:\n    RegisterRequest:\n      type: object\n      required: [name, username, email, password]\n      properties:\n        name: { type: string }\n        username: { type: string }\n        email: { type: string, format: email }\n        password: { type: string }\n\n    LoginRequest:\n      type: object\n      required: [username, password]\n      properties:\n        username: { type: string }\n        password: { type: string }\n\n    PasswordChangeRequest:\n      type: object\n      required: [current_password, new_password, confirm_password]\n      properties:\n        current_password: { type: string }\n        new_password: { type: string }\n        confirm_password: { type: string }\n\n    PaperSubmissionRequest:\n      type: object\n      required: [metadata, manuscript]\n      properties:\n        metadata:\n          $ref: '#/components/schemas/PaperMetadata'\n        manuscript:\n          type: string\n          format: binary\n\n    PaperDraftRequest:\n      type: object\n      required: [metadata]\n      properties:\n        metadata:\n          $ref: '#/components/schemas/PaperMetadata'\n\n    PaperMetadata:\n      type: object\n      required: [title, abstract]\n      properties:\n        title: { type: string }\n        abstract: { type: string }\n        keywords:\n          type: array\n          items: { type: string }\n\n    RefereeAssignRequest:\n      type: object\n      required: [referee_email]\n      properties:\n        referee_email: { type: string, format: email }\n\n    ReviewSubmissionRequest:\n      type: object\n      required: [review_text, recommendation]\n      properties:\n        review_text: { type: string }\n        recommendation:\n          type: string\n          enum: [accept, reject]\n\n    DecisionRequest:\n      type: object\n      required: [decision]\n      properties:\n        decision:\n          type: string\n          enum: [accept, reject]\n\n    ScheduleGenerateRequest:\n      type: object\n      properties:\n        conference_id: { type: string }\n\n    ScheduleEditRequest:\n      type: object\n      required: [items]\n      properties:\n        items:\n          type: array\n          items:\n            $ref: '#/components/schemas/ScheduleItem'\n\n    ScheduleItem:\n      type: object\n      required: [paper_id, room_id, time_slot_id]\n      properties:\n        paper_id: { type: string }\n        room_id: { type: string }\n        time_slot_id: { type: string }\n\n    RegistrationRequest:\n      type: object\n      required: [conference_id, attendance_type]\n      properties:\n        conference_id: { type: string }\n        attendance_type: { type: string }\n\n    PaymentRequest:\n      type: object\n      required: [payment_details]\n      properties:\n        payment_details: { type: string }\nEOF"} thread_id=019c45c9-8c4e-7503-a2c1-503a7ea82ca9
