+  std::string expiry;
+  std::string cvv;
+  bool simulate_decline = false;
+  bool simulate_record_failure = false;
+};
+
+enum class PaymentStatus {
+  kPaid,
+  kInvalidPaymentInfo,
+  kDeclined,
+  kRegistrationNotFound,
+  kDuplicatePayment,
+  kSystemError,
+};
+
+struct PaymentResult {
+  PaymentStatus status;
+  std::string message;
+  int payment_id;
+  int ticket_id;
+};
+
